---
layout: null
sitemap: false
---
{
  "repository": {{ site.data.affiliate_admin.repository | jsonify }},
  "branch": {{ site.data.affiliate_admin.branch | jsonify }},
  "models": [{% for model in site.models %}{"id": {{ model.model_id | jsonify }}, "name": {{ model.title | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "usages": {
    {% for product in site.data.affiliate_links.products %}
    {{ product.id | jsonify }}: [{% assign separator = '' %}{% for post in site.posts %}{% if post.affiliate_products contains product.id %}{{ separator }}{"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}}{% assign separator = ',' %}{% endif %}{% endfor %}]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
}
